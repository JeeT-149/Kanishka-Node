# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanishka_ops?schema=public"

# Authentication & Security
# Generate a secure 32+ character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-secure-secret-that-is-at-least-32-characters-long"
JWT_EXPIRES_IN="8h"
BCRYPT_ROUNDS=10

# CORS & Client Origin
CLIENT_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=30

# Optional Admin Console OTP (Phase 14)
# Disabled by default so the application runs without SMTP credentials.
ADMIN_OTP_ENABLED=false
OTP_DELIVERY=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
SMTP_FROM="Kiln & Leaf Ops <ops@example.com>"
